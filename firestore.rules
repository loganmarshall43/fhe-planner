rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Activities are world-readable so the public calendar works without sign-in.
    // Only signed-in users (the committee) can create or change them.
    match /activities/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // The roster (names + emails) stays committee-only.
    match /members/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
