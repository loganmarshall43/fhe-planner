rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in Google user can read/write. For a ward committee tool this is
    // usually enough; to lock it to the roster, tighten the write rule to check
    // request.auth.token.email against the members collection.
    match /activities/{doc} {
      allow read, write: if request.auth != null;
    }
    match /members/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
